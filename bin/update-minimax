#!/usr/bin/env bash

source constants

# Fetch last version of minimax
if [[ -d $MINIMAX_GITHUB_REPO ]]; then
  echo  "Pulling from MiniMax GitHub repository."
  rm -rf "$MINIMAX_CONF_REPO/MiniMax-backup"
  git -C $MINIMAX_GITHUB_REPO pull
else
  echo "MiniMax not in .config. Cloning from the GitHub repository."
  git clone \
    --filter=blob:none \
    git@github.com:nvim-mini/MiniMax.git \
    $MINIMAX_CONF_REPO
fi

# Create the real minimax config folder
NVIM_APPNAME=nvim-configs/nvim-minimax nvim -l $MINIMAX_GITHUB_REPO/setup.lua
