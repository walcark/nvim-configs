#!/usr/bin/env bash

source constants

# Fetch last version of minimax
git clone \
  --filter=blob:none \
  git@github.com:nvim-mini/MiniMax.git \
  $MINIMAX_GITHUB_REPO

# Create the real minimax config folder
NVIM_APPNAME=nvim-configs/nvim-minimax nvim -l $MINIMAX_GITHUB_REPO/setup.lua

# Delete git repository
rm -rf $MINIMAX_GITHUB_REPO

